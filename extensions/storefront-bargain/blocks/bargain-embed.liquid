{% comment %}
  CartGain Bargain — app embed.
  Works on ALL themes (including legacy / non-OS 2.0) where app blocks show
  "not found". Merchants enable it under: Theme settings -> App embeds.
  Shows a floating bargaining widget on product and cart pages.
{% endcomment %}

{%- if block.settings.enable_product and template contains 'product' -%}
  {%- assign embed_mode = 'product' -%}
  {%- assign v = product.selected_or_first_available_variant -%}
  {%- assign pprice = v.price | times: 1.0 | divided_by: 100 -%}
  {%- assign currency = cart.currency.iso_code | default: shop.currency -%}
  {%- assign img = v.featured_image | default: product.featured_image -%}
  {%- assign img_url = img | image_url: width: 640 -%}
  {%- assign title_enc = product.title | url_encode -%}
  {%- assign img_enc = img_url | url_encode -%}
  {%- assign widget_src = 'https://cart-gain.com/bargain/embed'
    | append: '?mode=' | append: 'item'
    | append: '&shop=' | append: shop.permanent_domain
    | append: '&product=' | append: product.id
    | append: '&variant=' | append: v.id
    | append: '&title=' | append: title_enc
    | append: '&price=' | append: pprice
    | append: '&currency=' | append: currency
    | append: '&image=' | append: img_enc -%}
{%- elsif block.settings.enable_cart and template == 'cart' -%}
  {%- assign embed_mode = 'cart' -%}
  {%- assign first_item = cart.items[0] -%}
  {%- if first_item -%}
    {%- assign iprice = first_item.final_price | times: 1.0 | divided_by: 100 -%}
    {%- assign iimg = first_item.image | image_url: width: 640 -%}
    {%- assign ititle = first_item.title | url_encode -%}
    {%- assign iimg_enc = iimg | url_encode -%}
  {%- endif -%}
  {%- assign widget_src = 'https://cart-gain.com/bargain/embed'
    | append: '?mode=' | append: 'cart'
    | append: '&shop=' | append: shop.permanent_domain
    | append: '&currency=' | append: cart.currency.iso_code | default: shop.currency
    | append: '&product=' | append: first_item.product.id
    | append: '&variant=' | append: first_item.variant.id
    | append: '&title=' | append: ititle
    | append: '&price=' | append: iprice
    | append: '&image=' | append: iimg_enc -%}
{%- endif -%}

{%- if widget_src and request.design_mode -%}
<div class="cg-bargain-embed" data-cg-bargain-embed>
  <div class="cg-bargain-embed__badge">CartGain Bargain (live preview)</div>
  <div class="cg-bargain-embed__panel">
    <div class="cg-bargain-placeholder" style="width:100%;height:120px;display:flex;align-items:center;justify-content:center;background:#f8fafc;border:1px dashed #cbd5e1;border-radius:8px;padding:12px;text-align:center;">
      <div style="color:#64748b;font-family:system-ui,sans-serif;font-size:13px;">
        Floating bargaining widget — preview disabled in theme editor. Appears on the live storefront.
      </div>
    </div>
  </div>
</div>
{%- elsif widget_src -%}
<div
  class="cg-bargain-embed cg-bargain-embed--{{ embed_mode }} cg-bargain-embed--{{ block.settings.position | default: 'bottom-right' }}"
  data-cg-bargain-embed
  data-mode="{{ embed_mode }}"
  data-heading="{{ block.settings.heading | escape }}"
>
  <div class="cg-bargain-embed__badge">{{ block.settings.heading }}</div>
  <div class="cg-bargain-embed__panel">
    <iframe
      class="cg-bargain-frame"
      data-cg-bargain
      src="{{ widget_src }}"
      title="CartGain price negotiation"
      loading="lazy"
      style="border:0;width:100%;height:200px;display:block;"
      allow="clipboard-write; clipboard-read"
    ></iframe>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "CartGain Bargain",
  "target": "body",
  "javascript": "bargain-embed.js",
  "stylesheet": "bargain.css",
  "settings": [
    {
      "type": "header",
      "content": "AI price negotiation"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Widget label",
      "default": "Bargain Now"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "default": "bottom-right",
      "options": [
        { "value": "bottom-right", "label": "Bottom right" },
        { "value": "bottom-left", "label": "Bottom left" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_product",
      "label": "Show on product pages",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_cart",
      "label": "Show on cart page",
      "default": true
    }
  ]
}
{% endschema %}
