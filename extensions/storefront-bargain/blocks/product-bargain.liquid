{% comment %}
  CartGain Bargain — product page block (drawer).
  Renders a native "Make an offer" CTA in the merchant's product information
  area. Clicking the CTA opens a fixed right-side drawer (full-screen sheet on
  mobile) via the bargain.js controller, which hosts the real-time negotiation
  widget in an iframe. The product page stays put behind the drawer.

  Variant data is embedded from Shopify's PUBLIC Liquid product object only —
  id / listed price / image. Merchant floors and margins are NEVER serialized
  here; the server re-derives them per session.
{% endcomment %}

{% assign v = product.selected_or_first_available_variant %}
{% assign pprice = v.price | times: 1.0 | divided_by: 100 %}
{% assign currency = cart.currency.iso_code | default: shop.currency %}
{% assign img = v.featured_image | default: product.featured_image %}
{% assign img_url = img | image_url: width: 640 %}
{% assign shop_domain = shop.permanent_domain %}
{% assign title_enc = product.title | url_encode %}
{% assign img_enc = img_url | url_encode %}
{% assign widget_src = 'https://cart-gain.com/bargain/embed'
  | append: '?mode=' | append: 'item'
  | append: '&shop=' | append: shop_domain
  | append: '&product=' | append: product.id
  | append: '&variant=' | append: v.id
  | append: '&title=' | append: title_enc
  | append: '&price=' | append: pprice
  | append: '&currency=' | append: currency
  | append: '&image=' | append: img_enc
%}

{%- comment -%}
  Compact variant map (public product data, JSON via Liquid): enables the
  controller to push cg_product_update when the buyer switches variants on the
  page before opening the drawer.
{%- endcomment -%}
{%- assign vjson = '' -%}
{%- for var in product.variants -%}
  {%- assign var_img = var.featured_image | default: product.featured_image -%}
  {%- if var_img -%}{%- assign var_img_enc = var_img | image_url: width: 640 | url_encode -%}{%- else -%}{%- assign var_img_enc = '' -%}{%- endif -%}
  {%- assign var_price = var.price | times: 1.0 | divided_by: 100 -%}
  {%- capture vjson -%}{{ vjson }}{% unless forloop.first %},{% endunless %}{"id":{{ var.id }},"price":{{ var_price }},"image":"{{ var_img_enc }}"}{%- endcapture -%}
{%- endfor -%}
{%- if product.variants.size > 0 -%}{%- assign vjson = vjson | prepend: '[' | append: ']' -%}{%- endif -%}

<div
  class="cg-bargain-block"
  data-cg-bargain-root
  {{ block.shopify_attributes }}
  data-cg-src="{{ widget_src | escape }}"
  data-cg-variant="{{ v.id }}"
  data-cg-variants="{{ vjson | escape }}"
  data-accent="{{ block.settings.accent | default: '#1d4ed8' | escape }}"
  style="--cg-accent: {{ block.settings.accent | default: '#1d4ed8' }};"
>
  {% if request.design_mode %}
    <!-- Theme editor preview: show a static representation of the CTA
         (the drawer + live widget are disabled in the theme editor). -->
    <div class="cg-bargain-cta cg-bargain-cta--preview">
      <span class="cg-bargain-cta__txt">{{ block.settings.heading }}</span>
      <span class="cg-bargain-cta__chev" aria-hidden="true">›</span>
    </div>
    <p class="cg-bargain-note">CartGain Bargain — opens the price-negotiation drawer on the live storefront.</p>
  {% else %}
    <!-- Live storefront: CTA opens the drawer (controller owns open/close). -->
    <button
      type="button"
      class="cg-bargain-cta"
      data-cg-bargain-open
      aria-haspopup="dialog"
      aria-expanded="false"
    >
      <svg class="cg-bargain-cta__ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
      </svg>
      <span class="cg-bargain-cta__txt">{{ block.settings.heading }}</span>
      <span class="cg-bargain-cta__chev" aria-hidden="true">›</span>
    </button>
  {% endif %}
</div>

{% schema %}
{
  "name": "CartGain Bargain",
  "target": "section",
  "javascript": "bargain.js",
  "stylesheet": "bargain.css",
  "templates": ["product"],
  "settings": [
    {
      "type": "header",
      "content": "AI price negotiation"
    },
    {
      "type": "paragraph",
      "content": "Shows a \"Make an offer\" button. Clicking it opens a negotiation drawer where shoppers agree a price before checkout; accepted deals create a real Shopify discount code scoped to this product."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Button label",
      "default": "Make an offer"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent color",
      "default": "#1d4ed8"
    }
  ]
}
{% endschema %}