{% comment %}
  CartGain Bargain — cart page block (inline experience).
  Shows the merchant's published Bargain Experience inline, then hands off to
  the negotiation chat for the first cart line. No floors of any kind are
  embedded in the page — the server is the only source of price truth.
{% endcomment %}

{% assign currency = cart.currency.iso_code | default: shop.currency %}
{% assign shop_domain = shop.permanent_domain %}
{% assign first_item = cart.items[0] %}
{% if first_item %}
  {% assign iprice = first_item.final_price | times: 1.0 | divided_by: 100 %}
  {% assign iimg = first_item.image | image_url: width: 640 %}
  {% assign ititle = first_item.title | url_encode %}
  {% assign iimg_enc = iimg | url_encode %}
{% endif %}
{% assign widget_src = 'https://cart-gain.com/bargain/embed'
  | append: '?mode=' | append: 'cart'
  | append: '&shop=' | append: shop_domain
  | append: '&currency=' | append: currency
  | append: '&product=' | append: first_item.product.id
  | append: '&variant=' | append: first_item.variant.id
  | append: '&title=' | append: ititle
  | append: '&price=' | append: iprice
  | append: '&image=' | append: iimg_enc
  | append: '&cart_token=' | append: cart.token
%}

<div
  class="cg-bargain-block"
  data-cg-bargain-root
  {{ block.shopify_attributes }}
  data-cg-surface="cart"
  {% unless request.design_mode %}data-cg-inline="true"{% endunless %}
  data-cg-src="{{ widget_src | escape }}"
  data-cg-variant="{{ first_item.variant.id }}"
  data-cg-variants=""
  data-accent="{{ block.settings.accent | default: '#1d4ed8' | escape }}"
  style="--cg-accent: {{ block.settings.accent | default: '#1d4ed8' }};"
>
  {% if request.design_mode %}
    <div class="cg-bargain-cta cg-bargain-cta--preview">
      <span class="cg-bargain-cta__txt">{{ block.settings.heading }}</span>
      <span class="cg-bargain-cta__chev" aria-hidden="true">›</span>
    </div>
    <p class="cg-bargain-note">CartGain Cart Bargain — shows the published experience inline on the live storefront.</p>
  {% else %}
    <div class="cg-bargain-inline" data-cg-inline-mount></div>
  {% endif %}
</div>
{% render 'cg-recovery-capture',
  surface: 'cart',
  enabled: block.settings.recovery_capture,
  delay: block.settings.recovery_delay,
  heading: block.settings.recovery_heading,
  copy: block.settings.recovery_copy,
  accent: block.settings.accent
%}

{% schema %}
{
  "name": "CartGain Cart Bargain",
  "target": "section",
  "javascript": "bargain.js",
  "stylesheet": "bargain.css",
  "enabled_on": { "templates": ["cart"] },
  "settings": [
    {
      "type": "header",
      "content": "AI price negotiation"
    },
    {
      "type": "paragraph",
      "content": "Lets shoppers negotiate the price of a cart item before checkout. Accepted deals create a real Shopify discount code."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Button label",
      "default": "Make an offer"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent color",
      "default": "#1d4ed8"
    },
    {
      "type": "header",
      "content": "Cart reminders"
    },
    {
      "type": "checkbox",
      "id": "recovery_capture",
      "label": "Show reminder opt-in on this page",
      "default": true
    },
    {
      "type": "range",
      "id": "recovery_delay",
      "label": "Show after (seconds)",
      "min": 5,
      "max": 120,
      "step": 5,
      "default": 20
    },
    {
      "type": "text",
      "id": "recovery_heading",
      "label": "Reminder heading",
      "default": "Almost yours - want a reminder?"
    },
    {
      "type": "textarea",
      "id": "recovery_copy",
      "label": "Reminder copy",
      "default": "We can email or WhatsApp you a link so you do not lose this cart."
    }
  ]
}
{% endschema %}