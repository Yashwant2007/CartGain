{% comment %}
  CartGain Bargain — cart page block.
  Lets shoppers bargain either a cart line item or the whole cart total
  (order-scoped code) right before they check out — no payment yet.
{% endcomment %}

{% assign currency = cart.currency.iso_code | default: shop.currency %}
{% assign shop_domain = shop.permanent_domain %}
{% assign first_item = cart.items[0] %}
{% if first_item %}
  {% assign iprice = first_item.final_price | times: 1.0 | divided_by: 100 %}
  {% assign iimg = first_item.image | image_url: width: 640 %}
  {% assign ititle = first_item.title | url_encode %}
  {% assign iimg_enc = iimg | url_encode %}
{% endif %}
{% assign widget_src = 'https://cart-gain.com/bargain/embed'
  | append: '?mode=' | append: 'cart'
  | append: '&shop=' | append: shop_domain
  | append: '&currency=' | append: currency
  | append: '&product=' | append: first_item.product.id
  | append: '&variant=' | append: first_item.variant.id
  | append: '&title=' | append: ititle
  | append: '&price=' | append: iprice
  | append: '&image=' | append: iimg_enc
%}

<div class="cg-bargain-block" data-cg-bargain-root {{ block.shopify_attributes }}>
  {% if request.design_mode %}
    <!-- Theme editor preview: show static placeholder -->
    <div class="cg-bargain-placeholder" style="border:0;width:100%;height:220px;display:flex;align-items:center;justify-content:center;background:#f8fafc;border:1px dashed #cbd5e1;border-radius:8px;padding:16px;text-align:center;">
      <div style="color:#64748b;font-family:system-ui,sans-serif;">
        <div style="font-size:24px;margin-bottom:8px;">🤝</div>
        <div style="font-weight:600;color:#334155;margin-bottom:4px;">CartGain Cart Bargain Widget</div>
        <div style="font-size:13px;color:#94a3b8;">Widget loads on live storefront.<br>Preview disabled in theme editor.</div>
      </div>
    </div>
  {% else %}
    <!-- Live storefront: load actual widget -->
    <iframe
      class="cg-bargain-frame"
      data-cg-bargain
      src="{{ widget_src }}"
      title="CartGain price negotiation"
      loading="lazy"
      style="border:0;width:100%;height:220px;display:block;"
      allow="clipboard-write; clipboard-read"
      sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox"
      referrerpolicy="origin"
    ></iframe>
  {% endif %}
</div>

{% schema %}
{
  "name": "CartGain Cart Bargain",
  "target": "section",
  "javascript": "bargain.js",
  "stylesheet": "bargain.css",
  "templates": ["cart"],
  "settings": [
    {
      "type": "header",
      "content": "AI price negotiation"
    },
    {
      "type": "paragraph",
      "content": "Lets shoppers negotiate the cart total or a chosen item before checkout. Accepted deals create a real Shopify discount code."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Need a better total?"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent color",
      "default": "#1d4ed8"
    }
  ]
}
{% endschema %}
