# ============================================
# CartGain — Custom Distribution app environment
# ============================================
# Copy to `.env.local` (local) or paste into the custom app's Vercel project
# environment variables (production). Never commit the real file.
#
# This is the SAME codebase as the public app. Only these values differ:
#   - the Shopify app credentials (custom app's client id/secret)
#   - the app's public URLs (custom subdomain)
#   - the database (use a SEPARATE database — see docs/shopify-custom-distribution.md)
#   - billing uses the Razorpay "direct / custom-app track" (no Shopify Billing)
#
# Scope note: the runtime OAuth scope list lives in src/lib/shopify-oauth.ts and
# is mirrored in shopify.app.custom.toml. SHOPIFY_API_SCOPES below is unused by
# the code and kept only for parity with .env.example.

# ── Database (use a SEPARATE Supabase project/database for the custom app) ──
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"
TEST_DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
APP_DATA_ENV="production"

# ── App URLs (custom subdomain) ──
NEXT_PUBLIC_APP_URL="https://custom.cart-gain.com"
NEXTAUTH_URL="https://custom.cart-gain.com"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ── Shopify: CUSTOM DISTRIBUTION app credentials ──
# Dev Dashboard → app "CartGain Custom" → Client credentials.
#   Client ID: 850b64332c8925413d0d6d8d39ede515
# MUST be the custom app's values — never the public app's.
SHOPIFY_API_KEY="850b64332c8925413d0d6d8d39ede515"
SHOPIFY_API_SECRET=""
# Kept for parity only; runtime scopes come from src/lib/shopify-oauth.ts.
SHOPIFY_API_SCOPES="read_checkouts,write_checkouts,read_orders,read_all_orders,read_customers,read_products,read_product_listings,read_discounts,write_discounts"
# Dedicated secret for signing Shopify OAuth state tokens. If unset, falls back
# to NEXTAUTH_SECRET. Generate with: openssl rand -base64 32
SHOPIFY_OAUTH_STATE_SECRET=""

# ── Billing (custom-app track = Razorpay; Shopify App Store billing is NOT used) ──
RAZORPAY_KEY_ID="rzp_live_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# ── Encryption (stores API keys/secrets at rest) ──
ENCRYPTION_KEY="generate-with: openssl rand -base64 32"

# ── AI ──
OPENAI_API_KEY="sk-..."
# AI fallback provider (Groq) — optional.
# AI_FALLBACK_API_KEY="gsk-..."
# AI_FALLBACK_BASE_URL="https://api.groq.com/openai/v1"
# AI_FALLBACK_MODEL="openai/gpt-oss-120b"
# BARGAIN_MODEL="gpt-4o"

# ── Channels: WhatsApp / Email / SMS ──
WHATSAPP_BUSINESS_TOKEN="EAx..."
WHATSAPP_PHONE_NUMBER_ID="123456789"
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
RESEND_API_KEY=""
FROM_EMAIL="noreply@cart-gain.com"
FROM_NAME="CartGain"
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ── Redis (Bull queues / background jobs; use a separate instance) ──
REDIS_HOST=""
REDIS_PORT="6379"
REDIS_PASSWORD=""
# REDIS_URL="redis://default:password@your-instance.upstash.io:6379"

# ── Cron / jobs auth (fail closed when unset) ──
JOB_SECRET="generate-with: openssl rand -base64 32"

# ── Misc ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
CASHFREE_WEBHOOK_SECRET=""
LINK_SECRET=""
ALERT_EMAIL=""
ALLOW_TEST_ENDPOINTS="false"
